# make sure that your ipmagnet container is named ipmagnet (the default
# service name in docker-compose.yml)
#
# ipMagnet's links are all relative, so it needs no base-URL setting; the
# /ipmagnet prefix is stripped before requests are forwarded.

location = /ipmagnet {
    return 301 /ipmagnet/;
}

# ^~ so swag's default "location ~ \.php" doesn't capture /ipmagnet/index.php
location ^~ /ipmagnet/ {
    include /config/nginx/proxy.conf;
    include /config/nginx/resolver.conf;
    set $upstream_app ipmagnet;
    set $upstream_port 80;
    set $upstream_proto http;
    # proxy_pass with variables doesn't strip the location prefix itself
    rewrite ^/ipmagnet(/.*)$ $1 break;
    proxy_pass $upstream_proto://$upstream_app:$upstream_port;
}
