# make sure that your ipmagnet container is named ipmagnet (the default
# service name in docker-compose.yml)
#
# ipMagnet's own links (magnet tracker URL, static assets, hash redirects)
# are all relative, so no app-side base-URL configuration is needed - nginx
# just strips the /ipmagnet/ prefix before forwarding to the container.
#
# NOTE: unlike the subdomain method, this serves ipMagnet under whatever
# domain swag's default site (site-confs/default.conf) answers for - by
# default that's every hostname that reaches swag without a more specific
# server_name match. If SWAG's URL/EXTRA_DOMAINS is set to your bare apex
# domain, this exposes ipMagnet at https://<yourdomain>/ipmagnet/ alongside
# anything else already served from that same domain/vhost.

location /ipmagnet/ {
    include /config/nginx/proxy.conf;
    include /config/nginx/resolver.conf;
    set $upstream_app ipmagnet;
    set $upstream_port 80;
    set $upstream_proto http;
    proxy_pass $upstream_proto://$upstream_app:$upstream_port/;
}
